# ==========================================
# NEXUS BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Port (Render sets this automatically to 10000; default locally 5000)
PORT=5000

# PostgreSQL Connection String (From Render PostgreSQL or Supabase/Neon)
# Example: postgresql://username:password@dpg-xxxxx-a.oregon-postgres.render.com/nexus_ecommerce
DATABASE_URL=postgresql://postgres:password@localhost:5432/Ecomerce?sslmode=disable

# JWT Secret for Customer & Admin Session Tokens (Use a random 32+ char string)
JWT_SECRET=your_super_secret_jwt_key_here_32chars

# Default Admin Portal Credentials (Used for admin authentication)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=greatstack123

# Supabase Storage Credentials (Recommended for fast & free image hosting)
# Get from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_BUCKET=products

# Cloudinary Image Upload Credentials (Optional alternative)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=582491527657413
CLOUDINARY_SECRET_KEY=SyKUdki9dyhmeCM59ARSpVY6Qs4

# Stripe Gateway (Optional for Card Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Razorpay Gateway (Optional for UPI / NetBanking / Cards)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
